    "import time,asyncio\n",
    "async def function1():\n",
    "    time.sleep(3)\n",
    "    print(\"Funciton1\")\n",
    "\n",
    "async def function2():\n",
    "    time.sleep(3)\n",
    "    print(\"Funcion 2\")\n",
    "\n",
    "async def function3():\n",
    "    time.sleep(3)\n",
    "    print(\"function 3\")\n",
    "\n",
    "async def main():\n",
    "    await function1()\n",
    "    await function2()\n",
    "    await function3()\n",
    "\n",
    "\n",
    "asyncio.run(main())\n"
