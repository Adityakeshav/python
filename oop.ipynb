    "class Employee:\n",
    "    def __init__(self,name,id):\n",
    "        self.name=name\n",
    "        self.id=id\n",
    "\n",
    "    def showDetails(self):\n",
    "        print(f\"The nameo of employee {self.name} is {self.id}\")\n",
    "\n",
    "class Programmer(Employee):\n",
    "    def showLang(slef):\n",
    "        print(\"the default langugae is python\")\n",
    "\n",
    "\n",
    "e1=Employee(\"Rohan Das\",100)\n",
    "e1.showDetails()\n",
    "\n",
    "e2=Programmer(\"Aditya\",122)\n",
    "e2.showLang()\n"
   ]
