     "text": [
      "Good Morning\n",
      "Hello World\n",
      "thanks for using this function\n",
      "\n",
      "\n",
      "Good Morning\n",
      "9\n",
      "thanks for using this function\n"
     ]
    }
   ],
   "source": [
    "\n",
    "\n",
    "def greet(fx):\n",
    "    def mfx(*args,**kwargs):\n",
    "        print(\"Good Morning\")\n",
    "        fx(*args,**kwargs)\n",
    "        print(\"thanks for using this function\")\n",
    "\n",
    "    return mfx\n",
    "\n",
    "@greet\n",
    "def Hello():\n",
    "    print(\"Hello World\")\n",
    "\n",
    "@greet\n",
    "def sum(a,b):\n",
    "    print(a+b)\n",
    "\n",
    "Hello()\n",
    "\n",
    "print()\n",
    "\n",
    "# greet(Hello)()\n",
    "\n",
    "# greet(sum)(5,2)\n",
    "\n",
    "print()\n",
    "\n",
    "sum(4,5)\n",
    "\n"
   ]
  },
